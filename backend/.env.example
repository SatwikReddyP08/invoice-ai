# ==============================================================================
# InVoice AI - Backend Environment Configuration Template
# Copy this file to .env and provide your local credentials. Do not commit .env.
# ==============================================================================

PROJECT_NAME="InVoice AI"
API_V1_STR="/api/v1"

# PostgreSQL Database Configuration
# You can provide individual fields OR provide a unified DATABASE_URL (e.g. from Supabase / Render)
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_SERVER=localhost
POSTGRES_USER=invoice_app
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=invoice_db
POSTGRES_PORT=5432

# CORS Configuration (comma-separated or JSON list, defaults to "*" if unset)
# BACKEND_CORS_ORIGINS=["https://your-frontend.vercel.app","http://localhost:5173"]

# Groq Vision API Configuration (Required for LLM-Assisted Stage 1 & Stage 3 Review)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Deterministic Analysis Policy Thresholds
PRICE_CHANGE_THRESHOLD_PERCENT=10.0
PRICE_CHANGE_MATERIAL_PERCENT=25.0
MONETARY_TOLERANCE=0.05
